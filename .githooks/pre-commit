#!/usr/bin/env bash
set -eu

repo_root=$(git rev-parse --show-toplevel)
metadata_script="$repo_root/tools/update_docs_metadata.py"
variables_file="$repo_root/docs/variables.xml"

if [ -f "$metadata_script" ]; then
    python3 "$metadata_script"
    if [ -f "$variables_file" ]; then
        git add -- "docs/variables.xml"
    fi
fi

exit 0